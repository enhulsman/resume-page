---
// A project page (openspec stone-inner-pages, stone-project-pages): the stone article, layout ac.
// The head opens like the project's chapter on the homepage (its card's index in that card's hue,
// the title, the hook); the right column holds the window `innerGlass` names for the route, then
// the contents, the facts and the numbers (its `stats` frontmatter, else its listing's first three
// dims). ANNA's page keeps her plate in the window's place until her own window replaces it.
import OverzichtLayout from "./OverzichtLayout.astro";
import Article from "../components/stone/Article.astro";
import ProjectWindow from "../components/stone/ProjectWindow.astro";
import AnnaPlate from "../components/overzicht/AnnaPlate.astro";
import { details, annaLead } from "../lib/project-pages.ts";
import { factsOf, numbersOf } from "../lib/article.ts";
import { glassCards, hueInk, innerGlass } from "../config/glass.ts";
import site from "../config/site";

const { frontmatter } = Astro.props;
const { title, hook = "", tech = [], description = "" } = frontmatter;

const path = Astro.url.pathname.replace(/\/$/, "");
const detail = details.find((d) => d.href === path);
const isAnna = path === annaLead.href;
const cardId = isAnna ? "anna" : detail?.id;
const ci = glassCards.findIndex((c) => c.id === cardId);
const index = ci >= 0 ? String(ci + 1).padStart(2, "0") : undefined;
const hue = ci >= 0 ? hueInk(glassCards[ci]) : undefined;

// every built project route has an entry (tests/inner-pages.test.mjs); a sketch that renders a
// project's MDX under its own route gets none
const moments = innerGlass[path] ?? [];
const ARTEFACTS = ["henk", "sandbox", "bible"] as const;
const artefact = moments.find((m): m is (typeof ARTEFACTS)[number] => (ARTEFACTS as readonly string[]).includes(m));

const facts = factsOf(frontmatter, "project");
const numbers = numbersOf({ kind: "project", stats: frontmatter.stats, dims: detail?.dims });

const projectKeywords =
  tech.length > 0
    ? `${site.seo.keywords}, ${tech.join(", ")}, project case study, portfolio`
    : `${site.seo.keywords}, project case study, portfolio`;
---

<OverzichtLayout
  current="projects"
  title={`${title} — ${site.name}`}
  description={description}
  keywords={projectKeywords}
  ogTitle={`${title} — Project by ${site.name}`}
  ogDescription={description}
  ogType="article"
>
  <Article title={title} lead={hook} index={index} hue={hue} facts={facts} numbers={numbers} moment={artefact ?? (isAnna ? "anna" : undefined)}>
    {artefact && <ProjectWindow slot="window" id={artefact} class="art-stage" />}
    {!artefact && isAnna && <div slot="window" class="plate"><AnnaPlate /></div>}
    <slot />
  </Article>
</OverzichtLayout>
