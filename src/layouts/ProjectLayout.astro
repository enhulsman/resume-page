---
// A case study, drawn as a sheet in the set: title block, the project's own drawing at full
// size (ANNA's is the homepage's model; projects without one have no plate), then the write-up.
import OverzichtLayout from "./OverzichtLayout.astro";
import AnnaPlate from "../components/overzicht/AnnaPlate.astro";
import { drawings } from "../components/overzicht/drawings";
import { annaLead, details } from "../config/home";
import site from "../config/site";

const { frontmatter } = Astro.props;
const { title, date, dateLabel = "", hook = "", tech = [], preview = "", github = "", description = "" } = frontmatter;
const githubUrl = github.startsWith("http") ? github : `${site.social.GitHub}/${github}`;
const bare = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");

const formattedDate = date
  ? new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", timeZone: "UTC" })
  : null;

const path = Astro.url.pathname.replace(/\/$/, "");
const detail = details.find((d) => d.caseStudy === path);
const Drawing = detail && drawings[detail.id];
const isAnna = path === annaLead.caseStudy;

const projectDescription =
  description ||
  `Case study: ${title} - A detailed look at the development process, technologies used, and key learnings from this project.`;
const projectKeywords =
  tech.length > 0
    ? `${site.seo.keywords}, ${tech.join(", ")}, project case study, portfolio`
    : `${site.seo.keywords}, project case study, portfolio`;
---

<OverzichtLayout
  current="projects"
  title={`${title} — ${site.name}`}
  description={projectDescription}
  keywords={projectKeywords}
  ogTitle={`${title} — Project by ${site.name}`}
  ogDescription={projectDescription}
  ogType="article"
>
  <article class="sheet sheet-first case">
    <header class="sheet-head case-head">
      <h1>{title}</h1>
      <div class="case-meta">
        {hook && <p class="lede">{hook}</p>}
        <table class="titleblock">
          <tr><th scope="row">Project</th><td>{title}</td></tr>
          {formattedDate && <tr><th scope="row">{dateLabel}</th><td>{formattedDate}</td></tr>}
          {tech.length > 0 && <tr><th scope="row">Stack</th><td>{tech.join(", ")}</td></tr>}
          {github && <tr><th scope="row">Code</th><td><a href={githubUrl}>{bare(githubUrl)}</a></td></tr>}
          {preview && <tr><th scope="row">Preview</th><td><a href={preview}>{bare(preview)}</a></td></tr>}
        </table>
      </div>
    </header>

    {(Drawing || isAnna) && (
      <div class="plate">
        {isAnna ? <AnnaPlate /> : <div class="dwg-wrap"><div class="dwg-scroll"><Drawing /></div></div>}
      </div>
    )}

    <div class="prose">
      <slot />
    </div>
  </article>
</OverzichtLayout>
