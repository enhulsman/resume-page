---
// The one layout every page uses: the stone ground, the stone bar and the footer (openspec
// stone-glass-homepage, shared chrome). No global.css, Tailwind, Lenis, sheet frame or dark theme;
// scrolling is the browser's own. Every page body is stone (openspec stone-inner-pages): no sheet
// class on main, no preload of the drawings' mono font, no hatch or arrow definitions here (the two drawings left carry
// their own in their pane). The homepage passes no `current`; an inner page names itself so the bar
// marks it.
import Metadata, { type MetadataProps } from "../components/Metadata.astro";
import Bar from "../components/overzicht/Bar.astro";
import Foot from "../components/overzicht/Foot.astro";
import "../styles/stone.css";
import "../styles/overzicht.css";

export type Props = MetadataProps & { current?: "projects" | "blog" | "resume" | "contact" };
const { current, ...meta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Metadata themeColor="#EEEAE3" {...meta} />
    <link rel="preload" href="/fonts/Archivo.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // the bar's scripted shape (the phone menu) from the first paint, not when chrome.js
      // arrives: on a slow phone the bar jumped
      document.documentElement.classList.add('js');
    </script>
    <noscript><style>
      /* without JS nothing folds the links into a menu: on a phone they wrap under the bar */
      @media (max-width: 860px) { .bar { flex-wrap: wrap; height: auto; padding-block: 10px; } .bar nav { display: flex !important; order: 3; flex-basis: 100%; gap: 18px; overflow-x: auto; } .bar-name { white-space: nowrap; } }
    </style></noscript>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Bar current={current} />

    <main id="main">
      <slot />
    </main>

    <Foot />

    <script>
      import '../scripts/overzicht/chrome.js';
    </script>
  </body>
</html>
