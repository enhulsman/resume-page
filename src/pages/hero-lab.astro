---
// Prototype of the glass hero (card run 7: H3, with H2 as the alternative), on G4's warm
// stone. Not linked from anywhere and not indexed. ?v=h2 shows H2; ?t=<seconds> freezes the light;
// ?lab=1 shows the lab bar (hidden by default; the parameters work without it).
// ?cards=5 adds Finance Bot as 05; ?look=before shows the cards before review round 3.
// ?blur=<0..1.5> sets one distance for every card (0 hard edges, 1 the study's softness);
// without it each card uses its own. Clicking the value goes back to per card.
// ?anna=turn|journey|stack picks ANNA's staging (lab only); ?name=glare sweeps a glare across the name.
import { glassCards, benched, h2Card, annaExploded, type GlassCard, type AnnaPane } from "../config/glass.ts";
import { annaLead, annaLevels } from "../config/home";
import { LABEL_Y, TURN_PANE, JOURNEY_PANE } from "../scripts/glass/anna-scene.js";
import site from "../config/site";
import Terminal from "../components/overzicht/Terminal.astro";

const role = `${site.role} at ${site.company}.`;
const intro = "I\u00a0build ANNA, an AI assistant in Microsoft Teams that does the admin no one should spend their day on.";
const nav = [
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "/blog" },
  { label: "Résumé", href: "/resume" },
  { label: "Contact", href: "/contact" },
];
const idx = (i: number) => String(i + 1).padStart(2, "0");
const rgb = (c: GlassCard | AnnaPane) => `rgb(${c.base.join(" ")})`;
const lit = (p: AnnaPane) => ({ "data-light": p.light, "data-base": JSON.stringify(p.base), "data-tune": JSON.stringify(p.tune), "data-distance": p.distance, "data-wash": JSON.stringify(p.wash), "data-quiet": "off", style: `--base: ${rgb(p)}` });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#EEEAE3" />
    <title>{site.name} (hero lab)</title>
    <link rel="preload" href="/fonts/Archivo.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      const q = new URLSearchParams(location.search), h = document.documentElement;
      h.dataset.v = q.get('v') === 'h2' ? 'h2' : 'h3';
      h.dataset.cards = q.get('cards') === '5' ? '5' : '4';
      h.dataset.look = q.get('look') === 'before' ? 'before' : 'now';
      if (q.get('lab') === '1') h.dataset.lab = '';
      h.dataset.name = q.get('name') === 'glare' ? 'glare' : 'plain';
      h.dataset.anna = ['journey', 'stack'].includes(q.get('anna')) ? q.get('anna') : 'turn';
    </script>
  </head>
  <body>
    <header class="bar">
      <a class="mark" href="/" aria-label={site.name}>EH.</a>
      <nav aria-label="Site">
        {nav.map(n => <a href={n.href}>{n.label}</a>)}
        <a class="pill" href="/contact">Get in touch</a>
      </nav>
    </header>

    <main>
      <!-- H3: the name, and the work as four lights -->
      <section class="hero h3" aria-labelledby="name-h3">
        <div class="top">
          <h1 id="name-h3" class="name" data-glare={"Ezra\nHulsman"}>Ezra<br />Hulsman</h1>
          <p class="intro">{role} {intro}</p>
        </div>
        <ul class="cards" aria-label="Projects">
          {[...glassCards, ...benched].map((c, i) => (
            <li class={i >= glassCards.length ? 'bench' : undefined}>
              <a class="glass-card" href={c.href} data-light={c.light} data-base={JSON.stringify(c.base)} data-tune={c.tune && JSON.stringify(c.tune)} data-distance={c.distance} data-wash={JSON.stringify(c.wash)} data-tune-before={c.before?.tune && JSON.stringify(c.before.tune)} style={`--base: ${rgb(c)}`}>
                <canvas aria-hidden="true"></canvas>
                <span class="title">{c.title}</span>
                <span class="idx" aria-hidden="true">{idx(i)}</span>
                <span class="readout">{c.readout}</span>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- H2: the name, and one light: ANNA -->
      <section class="hero h2" aria-labelledby="name-h2">
        <div class="copy">
          <h1 id="name-h2" class="name">Ezra<br />Hulsman</h1>
          <p class="role">{role.replace(/\.$/, "")}</p>
          <p class="intro">{intro}</p>
          <p class="actions">
            <a class="pill" href="/contact">Get in touch</a>
            <a class="pill ghost" href="/resume">Résumé</a>
          </p>
        </div>
        <a class="glass-card big" href={h2Card.href} data-light={h2Card.light} data-base={JSON.stringify(h2Card.base)} data-tune={h2Card.tune && JSON.stringify(h2Card.tune)} data-distance={h2Card.distance} data-wash={JSON.stringify(h2Card.wash)} data-tune-before={h2Card.before?.tune && JSON.stringify(h2Card.before.tune)} style={`--base: ${rgb(h2Card)}`}>
          <canvas aria-hidden="true"></canvas>
          <span class="title">{h2Card.title}</span>
          <span class="idx" aria-hidden="true">01</span>
          <span class="readout">{h2Card.readout}</span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      </section>

      <!-- lab only, staging A (?anna=turn): the ANNA card, turned. Face-on its four level lights are
           the one flame; scrolling or a sideways drag turns it and the levels come apart by depth,
           each one's copy beside its light. -->
      <section class="anna-turn" aria-labelledby="anna-turn-h">
        <div class="turn-stage">
          <div class="turn-head">
            <h2 id="anna-turn-h">ANNA</h2>
            <p>{annaLead.text}.</p>
            <a class="more" href={annaLead.href}>How ANNA is built <span aria-hidden="true">→</span></a>
          </div>
          <div class="turn-scene">
            <div class="turn-tilt">
              <div class="glass-card turn-pane" data-light="0" data-base={JSON.stringify(glassCards[0].base)} data-quiet="off" style={`--base: ${rgb(glassCards[0])}; aspect-ratio: ${TURN_PANE.w} / ${TURN_PANE.h}`}>
                <canvas aria-hidden="true"></canvas>
                <span class="title" aria-hidden="true">ANNA</span>
                <span class="readout" aria-hidden="true">{glassCards[0].readout}</span>
                {LABEL_Y.map((y) => <i class="mark" aria-hidden="true" style={`top: ${(100 * y / TURN_PANE.h).toFixed(2)}%`}></i>)}
              </div>
            </div>
            <ol class="levels">
              {annaLevels.map((l, i) => (
                <li style={`top: ${(100 * LABEL_Y[i] / TURN_PANE.h).toFixed(2)}%`}><h3>{l.name}</h3><p>{l.text}</p></li>
              ))}
            </ol>
          </div>
          <p class="turn-caption" aria-hidden="true"></p>
        </div>
      </section>

      <!-- lab only, staging B (?anna=journey): one tall pane; reading down the levels sends the
           question down, out along a connector and back up as one message. -->
      <section class="anna-journey" aria-labelledby="anna-journey-h">
        <div class="journey-stage">
          <div class="glass-card journey-pane" aria-hidden="true" data-light="0" data-base={JSON.stringify(glassCards[0].base)} data-quiet="off" style={`--base: ${rgb(glassCards[0])}; aspect-ratio: ${JOURNEY_PANE.w} / ${JOURNEY_PANE.h}`}><canvas></canvas></div>
        </div>
        <div class="journey-steps">
          <div class="step intro">
            <h2 id="anna-journey-h">ANNA</h2>
            <p>{annaLead.text}.</p>
          </div>
          {annaLevels.map((l, i) => (
            <div class="step" data-step={i}><h3>{l.name}</h3><p>{l.text}</p></div>
          ))}
          <div class="step end"><a class="more" href={annaLead.href}>How ANNA is built <span aria-hidden="true">→</span></a></div>
        </div>
      </section>

      <!-- lab only (?anna=stack, task 2.3): ANNA as four glass panes over one flame. Scrolling in pulls the
           block apart; the level being read slides out and sharpens; drag or the buttons turn it. -->
      <section class="anna-x" aria-labelledby="anna-h">
        <div class="anna-stage">
          <div class="stack" aria-hidden="true">
            {annaExploded.panes.map((p) => <div class="glass-card slab" {...lit(p)}><canvas></canvas></div>)}
          </div>
          <div class="turn" role="group" aria-label="Turn the stack">
            <button type="button" data-turn="-1" aria-label="Turn left">&larr;</button>
            <button type="button" data-turn="1" aria-label="Turn right">&rarr;</button>
            <button type="button" data-tilt aria-label="Tilt edge-on and back">&#8597;</button>
            <span>Drag to turn</span>
          </div>
        </div>
        <div class="anna-steps">
          <div class="step intro">
            <h2 id="anna-h">ANNA</h2>
            <p>{annaLead.text}.</p>
            <a class="more" href={annaLead.href}>How ANNA is built <span aria-hidden="true">→</span></a>
          </div>
          {annaExploded.panes.map((p, i) => (
            <div class="step" data-step={i}><h3>{p.name}</h3><p>{p.text}</p></div>
          ))}
        </div>
      </section>

      <!-- lab only: the terminal as a clean frosted glass window over a soft glow of the hero's four
           colours; the hero's panes reflect, upside down and faint, along its top inside edge -->
      <section class="term-lab" aria-label="Terminal">
        <div class="term-glow" aria-hidden="true"></div>
        <div class="term-window">
          <div class="term-reflect" aria-hidden="true">
            {glassCards.map(c => (
              <span class="glass-card mini" data-light={c.light} data-base={JSON.stringify(c.base)} data-tune={c.tune && JSON.stringify(c.tune)} data-distance={Math.max(1, c.distance)} data-wash={JSON.stringify(c.wash)} data-quiet="off" style={`--base: ${rgb(c)}`}><canvas></canvas></span>
            ))}
          </div>
          <div class="term-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="term-title">ezra@hulsman: ~</span></div>
          <Terminal />
        </div>
      </section>
    </main>

    <nav class="lab" aria-label="Variant">
      <span class="seg"><a href="?v=h3" data-key="v" data-val="h3">H3</a><a href="?v=h2" data-key="v" data-val="h2">H2</a></span>
      <span class="seg"><a href="?cards=4" data-key="cards" data-val="4">4</a><a href="?cards=5" data-key="cards" data-val="5">5</a></span>
      <span class="seg"><a href="?look=now" data-key="look" data-val="now" title="the cards now">now</a><a href="?look=before" data-key="look" data-val="before" title="before review round 3: no wash, upright flame, darker Henk">before</a></span>
      <span class="seg"><a href="?name=plain" data-key="name" data-val="plain" title="the name as plain text">name</a><a href="?name=glare" data-key="name" data-val="glare" title="a glare sweeps across the name (hover it to replay)">glare</a></span>
      <span class="seg"><a href="?anna=turn" data-key="anna" data-val="turn" title="ANNA: the card, turned">turn</a><a href="?anna=journey" data-key="anna" data-val="journey" title="ANNA: the question goes down and comes back">journey</a><a href="?anna=stack" data-key="anna" data-val="stack" title="ANNA: the exploded stack">stack</a></span>
      <label class="dial">distance <input id="blur" type="range" min="0" max="1.5" step="0.05" value="1" /> <output id="blur-out" title="back to each card's own">per card</output></label>
    </nav>

    <script>
      import "../scripts/glass/hero.js";
      import "../scripts/glass/anna.js";
      import "../scripts/glass/anna-turn.js";
      import "../scripts/glass/anna-journey.js";
      import "../scripts/glass/glare.js";
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: "Archivo"; src: url(/fonts/Archivo.woff2) format("woff2-variations"); font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; }

  :root {
    --stone: #EEEAE3;
    --ink: #111110;
    --ink-2: #2a2826;
    --gutter: clamp(16px, 2.2vw, 32px);
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: var(--stone);
    color: var(--ink);
    font: 400 16px/1.4 "Archivo", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    word-spacing: 0.06em;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }

  html[data-v="h3"] .hero.h2, html[data-v="h2"] .hero.h3 { display: none; }

  .bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px var(--gutter) 0;
  }
  .mark { font: 900 28px/1 "Archivo"; letter-spacing: -0.04em; }
  .bar nav { display: flex; align-items: center; gap: clamp(16px, 3.2vw, 46px); font-weight: 450; font-size: 17px; }
  .pill {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--ink); color: var(--stone);
    padding: 9px 20px; border-radius: 999px; font-weight: 500;
  }
  .pill.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }

  .name {
    margin: 0;
    font: 900 clamp(64px, min(13.6vw, 21svh), 212px)/0.84 "Archivo";
    font-stretch: 88%;
    letter-spacing: -0.045em;
    margin-left: -0.04em;
  }

  /* ---- H3 ---- */
  .h3 { padding: clamp(32px, 4.4vw, 64px) var(--gutter) 40px; }
  .h3 .top {
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: end;
    column-gap: clamp(24px, 4vw, 64px);
  }
  .h3 .intro {
    margin: 0 0 0.35em; max-width: 33ch; justify-self: end;
    font-size: clamp(18px, 1.75vw, 25px); line-height: 1.32; color: var(--ink-2); text-wrap: pretty;
  }
  .cards {
    list-style: none; margin: clamp(28px, 3.6vw, 52px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(8px, 1vw, 14px);
  }

  /* ---- the card ---- */
  .glass-card {
    position: relative; display: block; aspect-ratio: 296 / 340;
    border-radius: clamp(12px, 1.3vw, 18px);
    background: var(--base);
    color: var(--ink);
    transition: transform 0.35s cubic-bezier(.2,.7,.2,1);
    box-shadow: 0 1px 1px rgb(70 50 30 / 0.06), 0 14px 28px -18px rgb(70 50 30 / 0.35);
  }
  /* four across: the row never pushes the cards below the first screen */
  .h3 .glass-card { aspect-ratio: auto; width: 100%; height: min(40svh, 27vw); }
  .glass-card canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; border-radius: inherit; }
  /* the glass edge: a light rim above the light */
  .glass-card::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 1px 0 0 rgb(255 255 255 / 0.6), inset -1px 0 0 rgb(255 255 255 / 0.6),
      inset 0 -1px 0 rgb(80 60 40 / 0.12),
      inset 0 0 0 1px rgb(255 255 255 / 0.18),
      inset 0 0 9px 1px rgb(255 255 255 / 0.22);
  }
  .glass-card > span { position: absolute; z-index: 1; }
  .glass-card .title { left: 7%; top: 6.5%; font-weight: 680; font-size: clamp(15px, 1.5vw, 22px); letter-spacing: -0.02em; line-height: 1.1; }
  .glass-card .idx { right: 7%; top: 7.2%; font-weight: 450; font-size: clamp(11px, 0.9vw, 13px); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; }
  .glass-card .readout { left: 7%; bottom: 6.5%; font-weight: 480; font-size: clamp(12px, 1.05vw, 15px); font-variant-numeric: tabular-nums; }
  .glass-card .go {
    right: 7%; bottom: 6.5%; font-weight: 500; font-size: clamp(13px, 1.1vw, 16px); line-height: 1;
    transition: transform 0.35s cubic-bezier(.2,.7,.2,1);
  }
  a.glass-card:hover, a.glass-card:focus-visible { transform: translateY(-3px); }
  .glass-card:hover .go, .glass-card:focus-visible .go { transform: translateX(4px); }
  .glass-card:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* ---- H2 ---- */
  .h2 {
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center;
    gap: clamp(24px, 4vw, 72px);
    padding: clamp(32px, 5vw, 72px) var(--gutter) 48px;
    min-height: calc(100svh - 70px);
  }
  .h2 .name { font-size: clamp(64px, 10.4vw, 160px); }
  .h2 .role { margin: 0.9em 0 0; font-weight: 640; font-size: clamp(18px, 1.9vw, 28px); letter-spacing: -0.015em; }
  .h2 .intro { text-wrap: pretty; margin: 0.6em 0 0; max-width: 34ch; font-size: clamp(17px, 1.6vw, 23px); line-height: 1.34; color: var(--ink-2); }
  .h2 .actions { display: flex; gap: 12px; margin: 1.6em 0 0; }
  .h2 .actions .pill { padding: 13px 26px; font-size: 17px; }
  .glass-card.big { width: min(100%, 520px); justify-self: end; border-radius: clamp(16px, 2vw, 26px); }
  .glass-card.big .title { font-size: clamp(18px, 1.7vw, 24px); }
  .glass-card.big .readout { font-size: clamp(13px, 1.15vw, 16px); }

  /* the lab bar: hidden unless ?lab=1 (Ezra settled on H3, four cards, now, per-card distance) */
  html:not([data-lab]) .lab { display: none; }
  .lab { position: fixed; right: 12px; bottom: 12px; display: flex; gap: 2px; font: 500 12px/1 "Archivo"; background: rgb(17 17 16 / 0.85); border-radius: 999px; padding: 3px; }
  .lab a { color: #ddd; padding: 6px 10px; border-radius: 999px; }
  .lab .dial { display: flex; align-items: center; gap: 8px; color: #ddd; padding: 0 12px 0 10px; }
  .lab .dial input { width: 140px; accent-color: #EEEAE3; }
  .lab .dial output { font-variant-numeric: tabular-nums; min-width: 7ch; cursor: pointer; }
  .lab .seg { display: flex; gap: 0; padding-right: 6px; border-right: 1px solid rgb(255 255 255 / 0.15); }
  html[data-v="h3"] .lab a[data-key="v"][data-val="h3"], html[data-v="h2"] .lab a[data-key="v"][data-val="h2"],
  html[data-cards="4"] .lab a[data-key="cards"][data-val="4"], html[data-cards="5"] .lab a[data-key="cards"][data-val="5"],
  html[data-look="now"] .lab a[data-key="look"][data-val="now"], html[data-look="before"] .lab a[data-key="look"][data-val="before"],
  html[data-name="plain"] .lab a[data-key="name"][data-val="plain"], html[data-name="glare"] .lab a[data-key="name"][data-val="glare"],
  html[data-anna="turn"] .lab a[data-key="anna"][data-val="turn"], html[data-anna="journey"] .lab a[data-key="anna"][data-val="journey"], html[data-anna="stack"] .lab a[data-key="anna"][data-val="stack"] { background: #EEEAE3; color: #111; }

  /* lab: four or five cards; five keep the original 296 x 360 card */
  html[data-cards="4"] .cards li.bench { display: none; }
  html[data-cards="5"] .cards { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  html[data-cards="5"] .h3 .glass-card { height: auto; aspect-ratio: 296 / 360; }
  /* lab: before review round 3 the titles were a touch lighter */
  html[data-look="before"] .glass-card .title { font-weight: 640; }

  /* ---- ANNA's section (lab only) ---- */
  html:not([data-lab]) .anna-x, html:not([data-anna="stack"]) .anna-x { display: none; }
  .anna-x {
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    column-gap: clamp(24px, 5vw, 96px); padding: 0 var(--gutter);
  }
  .anna-steps { grid-column: 1; grid-row: 1; padding-bottom: 30svh; }
  .anna-stage { grid-column: 2; grid-row: 1; position: sticky; top: 0; height: 100svh; touch-action: pan-y; cursor: grab; user-select: none; }
  .anna-stage.dragging { cursor: grabbing; }
  .step { min-height: 62svh; display: flex; flex-direction: column; justify-content: center; max-width: 34ch; }
  .step.intro { min-height: 100svh; }
  .step h2 { margin: 0; font: 900 clamp(48px, 6.4vw, 104px)/0.9 "Archivo"; font-stretch: 88%; letter-spacing: -0.04em; }
  .step.intro p { margin: 0.8em 0 0; font-size: clamp(18px, 1.6vw, 23px); line-height: 1.34; color: var(--ink-2); text-wrap: pretty; }
  .step .more { margin-top: 1.2em; font-weight: 600; }
  .step h3 { margin: 0; font-weight: 700; font-size: clamp(22px, 2.2vw, 32px); letter-spacing: -0.02em; }
  .step[data-step] p { margin: 0.5em 0 0; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.4; color: var(--ink-2); text-wrap: pretty; }
  .step[data-step] { opacity: 0.38; transition: opacity 0.4s; }
  .step[data-step].reading { opacity: 1; }

  /* the panes: placed and turned by anna.js (translate, rotateX, rotateZ, no perspective) */
  .stack { position: absolute; inset: 0; --S: min(330px, 26vw, 34svh); }
  .glass-card.slab {
    position: absolute; left: 50%; top: 50%; width: var(--S); aspect-ratio: 1; border-radius: 14px;
    transform: translate(-50%, -50%) rotateX(60deg) rotateZ(-45deg);
    box-shadow: 0 1px 1px rgb(70 50 30 / 0.06), 0 22px 30px -16px rgb(70 50 30 / 0.4);
  }
  .slab:nth-child(1) { z-index: 4; } .slab:nth-child(2) { z-index: 3; } .slab:nth-child(3) { z-index: 2; } .slab:nth-child(4) { z-index: 1; }
  .turn { position: absolute; left: 50%; bottom: 5svh; transform: translateX(-50%); display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--ink-2); }
  .turn button { width: 34px; height: 34px; border-radius: 999px; border: 0; background: rgb(17 17 16 / 0.07); color: var(--ink); font: 500 15px/1 "Archivo"; cursor: pointer; }
  .turn button:hover { background: rgb(17 17 16 / 0.13); }
  .turn button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .turn span { margin-left: 6px; }

  /* ---- a glare across the name (lab, ?name=glare): light on black lacquer, one sweep on arrival
     and again when the pointer comes onto the name; ?glare=<0..1> holds one moment ---- */
  #name-h3 { position: relative; }
  #name-h3::after {
    /* the name again, as a pseudo-element so its text stays out of the page's text and the accessibility tree */
    content: attr(data-glare) / ""; white-space: pre;
    position: absolute; inset: 0; display: none; pointer-events: none; color: transparent;
    background:
