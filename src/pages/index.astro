---
// The homepage in stone and glass (openspec stone-glass-homepage): the hero, ANNA, Projects,
// Experience, Writing, About (with the terminal's window) and Contact, in that order.
import OverzichtLayout from "../layouts/OverzichtLayout.astro";
import Hero from "../components/stone/Hero.astro";
import AnnaSection from "../components/stone/AnnaSection.astro";
import Projects from "../components/stone/Projects.astro";
import Experience from "../components/stone/Experience.astro";
import Writing from "../components/stone/Writing.astro";
import About from "../components/stone/About.astro";
import Contact from "../components/stone/Contact.astro";
import site from "../config/site";

const title = `${site.name}, ${site.role}`;
const description = `${site.name} is a ${site.role} at ${site.company}, building ANNA, an AI assistant in Microsoft Teams. Python, AI agents and MCP, on a Linux and DevOps foundation.`;
---

<OverzichtLayout
  title={title}
  description={description}
  keywords={`${site.seo.keywords}, resume, portfolio, Utrecht, ${site.company}`}
>
  <Hero />
  <AnnaSection />
  <Projects />
  <Experience />
  <Writing />
  <About />
  <Contact />
</OverzichtLayout>

<script>
  import '../scripts/glass/panes.js';
  import '../scripts/glass/anna-window.js';
  import '../scripts/glass/artefacts.js';
</script>
