---
// The homepage in stone and glass (openspec stone-glass-homepage). The sections arrive in order,
// one change at a time: the hero now; ANNA, Projects, Experience, Writing, About and Contact next.
import OverzichtLayout from "../layouts/OverzichtLayout.astro";
import Hero from "../components/stone/Hero.astro";
import site from "../config/site";

const title = `${site.name}, ${site.role}`;
const description = `${site.name} is a ${site.role} at ${site.company}, building ANNA, an AI assistant in Microsoft Teams. Python, AI agents and MCP, on a Linux and DevOps foundation.`;
---

<OverzichtLayout
  title={title}
  description={description}
  keywords={`${site.seo.keywords}, resume, portfolio, Utrecht, ${site.company}`}
>
  <Hero />
</OverzichtLayout>

<script>
  import '../scripts/glass/panes.js';
</script>

<style is:global>
  /* Until the stone bar (chunk 3): the drawing-sheet bar is fixed over the page, so the hero
     starts below it. Goes with that bar. */
  main:has(> .hero) { padding-top: calc(var(--frame) + 6px + var(--bar)); }
</style>
