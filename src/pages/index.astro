---
import OverzichtLayout from "../layouts/OverzichtLayout.astro";
import YouSheet from "../components/overzicht/YouSheet.astro";
import AnnaSection from "../components/overzicht/AnnaSection.astro";
import DetailsSheet from "../components/overzicht/DetailsSheet.astro";
import RegisterSheet from "../components/overzicht/RegisterSheet.astro";
import RevisionsSheet from "../components/overzicht/RevisionsSheet.astro";
import NotesSheet from "../components/overzicht/NotesSheet.astro";
import ContactSheet from "../components/overzicht/ContactSheet.astro";
import site from "../config/site";

const title = `${site.name}, ${site.role}`;
const description = `${site.name} is a ${site.role} at ${site.company}, building ANNA, an AI assistant in Microsoft Teams. Python, AI agents and MCP, on a Linux and DevOps foundation.`;
---

<OverzichtLayout
  title={title}
  description={description}
  keywords={`${site.seo.keywords}, resume, portfolio, Utrecht, ${site.company}`}
>
  <YouSheet />
  <AnnaSection />
  <DetailsSheet />
  <RegisterSheet />
  <RevisionsSheet />
  <NotesSheet />
  <ContactSheet />
</OverzichtLayout>

<script>
  import '../scripts/overzicht/intro.js';
  import '../scripts/overzicht/main.js';
</script>
