---
// /blog: the whole site diary, newest first, each post with its description.
import OverzichtLayout from "../../layouts/OverzichtLayout.astro";
import site from "../../config/site";

// Auto-discover MDX posts in this folder, excluding drafts (leading underscore)
const entries = Object.entries(import.meta.glob("./*.mdx", { eager: true })) as [string, any][];

const posts = entries
  .filter(([path]) => !path.split("/").pop()!.startsWith("_"))
  .map(([, m]) => ({
    title: m.frontmatter?.title ?? "Untitled",
    description: m.frontmatter?.description ?? "",
    href: m.url ?? "",
    date: m.frontmatter?.date,
  }))
  .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());

const fmt = (d: string) =>
  d ? new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }) : "";
const iso = (d: string) => (d ? new Date(d).toISOString().slice(0, 10) : "");

const blogDescription = `Writing from ${site.name} — ${site.summary}`;
---

<OverzichtLayout
  current="blog"
  title={`Blog — ${site.name}`}
  description={blogDescription}
  ogTitle={`Blog — ${site.name}`}
  ogDescription={blogDescription}
>
  <section class="sheet sheet-first" aria-labelledby="blog-h">
    <header class="sheet-head">
      <h1 id="blog-h">Blog</h1>
      <p>Notes on infrastructure, tooling, and the occasional detour.</p>
    </header>
    <ul class="diary diary-full">
      {posts.map((p) => <li><time datetime={iso(p.date)}>{fmt(p.date)}</time><a href={p.href}>{p.title}</a><span>{p.description}</span></li>)}
    </ul>
  </section>
</OverzichtLayout>
