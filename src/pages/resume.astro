---
// /resume: the CV as a sheet. Experience is the revision table (newest first, lettered from A),
// skills and schooling are schedules. It prints on white: see the print block in overzicht.css.
import OverzichtLayout from "../layouts/OverzichtLayout.astro";
import site from "../config/site";
import { certifications, education, experience, skillCategories, spokenLanguages } from "../config/resume";

// The CV letters every role, oldest A, as the homepage's revision table does.
const letter = (e: (typeof experience)[number]) => String.fromCharCode(65 + experience.length - 1 - experience.indexOf(e));
const when = (e: (typeof experience)[number]) => `${e.startDate} – ${e.endDate ?? "present"}`;
const groups = [
  { id: "consulting", entries: experience.filter((e) => e.group === "consulting") },
  { id: "prior", entries: experience.filter((e) => e.group === "prior") },
];
// a drawing has no emoji: the flag stays in the terminal's `whoami`
const location = site.location.replace(/\s*[\u{1F1E6}-\u{1F1FF}]+/gu, "");
---

<OverzichtLayout
  current="resume"
  title={`Resume — ${site.name}`}
  description={`Professional resume of ${site.name}. ${site.role} at ${site.company}, based in ${site.location}.`}
  keywords={`${site.seo.keywords}, resume, CV, work experience, certifications`}
  ogTitle={`Resume — ${site.name}`}
  ogDescription={`${site.role} at ${site.company}. Work experience, skills, education, and certifications.`}
>
  <section class="sheet sheet-first cv-head" aria-labelledby="cv-h">
    <header class="sheet-head">
      <h1 id="cv-h">{site.name}</h1>
      <div>
        <p class="role">{site.role} at <a href={site.social.employer}>{site.company}</a> · {location}</p>
        <p>{site.summary}</p>
      </div>
    </header>
    <p class="actions">
      <a class="act act-main" href="/contact">Request my full CV</a>
      <a class="act" href={`mailto:${site.social.email}`}>Email me</a>
      <a class="act" href={site.social.LinkedIn}>LinkedIn</a>
      <a class="act" href={site.social.GitHub}>GitHub</a>
    </p>
  </section>

  <section class="sheet" aria-labelledby="exp-h">
    <header class="sheet-head">
      <h2 id="exp-h">Experience</h2>
    </header>
    {groups.map((g) => (
      <>
        <h3 class="sub">
          {g.id === "consulting" ? <>Consultant via <a href="https://anamata.nl">Anamata</a> (2023 – present)</> : "Prior Experience"}
        </h3>
        <ol class="revs">
          {g.entries.map((e) => (
            <li><span class="rev">{letter(e)}</span><span class="when">{when(e)}</span><div><h4>{e.role} <i>{e.client}</i></h4><p>{e.summary}</p></div></li>
          ))}
        </ol>
      </>
    ))}

    <div class="schedules schedules-cv">
      <table class="schedule">
        <caption><h2>Skills</h2></caption>
        <tr><th scope="row">Languages</th><td>{spokenLanguages.map((l) => `${l.name} (${l.level})`).join(" · ")}</td></tr>
        {skillCategories.map((c) => <tr><th scope="row">{c.label}</th><td>{c.items.join(" · ")}</td></tr>)}
      </table>
      <div class="schedule-stack">
        <table class="schedule">
          <caption><h2>Education</h2></caption>
          {education.map((e) => (
            <tr><th scope="row">{e.startYear} – {e.endYear}</th><td>{e.degree} — {e.institution}{(e.result || e.gpa) && <span class="sched-note">{[e.result, e.gpa && `${e.gpa} GPA`].filter(Boolean).join(" · ")}</span>}</td></tr>
          ))}
        </table>
        <table class="schedule">
          <caption><h2>Certifications</h2></caption>
          {certifications.map((c) => (
            <tr><th scope="row">{c.year}</th><td>{c.name} — {c.institution}{c.credential && <span class="sched-note">{c.credential}</span>}</td></tr>
          ))}
        </table>
      </div>
    </div>
  </section>
</OverzichtLayout>
