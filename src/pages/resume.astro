---
// /resume (openspec stone-inner-pages, stone-resume; Ezra, 2026-11-10, R3): the name, the role
// line, the summary and four actions, with the résumé's sunset far behind the name; then Experience
// with the years as the spine (each role's start year set large, its end under it), and Skills,
// Education and Certifications as hairline rows of type. Every word from site.ts, resume.ts and
// pageWords. It prints on white: the print block in stone.css.
import OverzichtLayout from "../layouts/OverzichtLayout.astro";
import PageLight from "../components/stone/PageLight.astro";
import site from "../config/site";
import { pageWords } from "../config/pages.ts";
import { plainLocation } from "../lib/article.ts";
import { certifications, education, experience, skillCategories, spokenLanguages } from "../config/resume";

const w = pageWords.resume;
const groups = [
  { id: "consulting", entries: experience.filter((e) => e.group === "consulting") },
  { id: "prior", entries: experience.filter((e) => e.group === "prior") },
];
const note = (e: (typeof education)[number]) => [e.result, e.gpa && `${e.gpa} ${w.gpa}`].filter(Boolean).join(" · ");
---

<OverzichtLayout
  current="resume"
  title={`Resume — ${site.name}`}
  description={`Professional resume of ${site.name}. ${site.role} at ${site.company}, based in ${site.location}.`}
  keywords={`${site.seo.keywords}, resume, CV, work experience, certifications`}
  ogTitle={`Resume — ${site.name}`}
  ogDescription={`${site.role} at ${site.company}. Work experience, skills, education, and certifications.`}
>
  <div class="cv">
    <header class="page-head cv-top">
      <PageLight id="resume" />
      <h1 class="page-title cv-name">{site.name}</h1>
      <p class="cv-role">{site.role} {w.at} <a href={site.social.employer}>{site.company}</a> · {plainLocation(site.location)}</p>
      <p class="cv-summary">{site.summary}</p>
      <p class="cv-actions">
        <a class="cv-main" href="/contact">{w.actions.cv}</a>
        <a href={`mailto:${site.social.email}`}>{w.actions.email}</a>
        <a href={site.social.LinkedIn}>{w.actions.linkedin}</a>
        <a href={site.social.GitHub}>{w.actions.github}</a>
      </p>
    </header>

    <section class="cv-exp" aria-labelledby="cv-exp-h">
      <h2 id="cv-exp-h" class="cv-h2">{w.experience}</h2>
      {groups.map((g) => (
        <>
          <h3 class="cv-group">
            {g.id === "consulting" ? <>{w.consulting.before} <a href={w.consulting.href}>{site.company}</a> ({w.consulting.since} – {w.present})</> : w.prior}
          </h3>
          <ol class="stone-rows cv-rows">
            {g.entries.map((e) => (
              <li class="cv-row">
                <span class="cv-years"><b>{e.startDate}</b><span>– {e.endDate ?? w.present}</span></span>
                <div>
                  <h4>{e.role} <span class="cv-client">{e.client}</span></h4>
                  <p>{e.summary}</p>
                </div>
              </li>
            ))}
          </ol>
        </>
      ))}
    </section>

    <div class="cv-more">
      <section aria-labelledby="cv-skills-h">
        <h2 id="cv-skills-h" class="cv-h3">{w.skills}</h2>
        <dl class="stone-rows cv-table">
          <div><dt>{w.languages}</dt><dd>{spokenLanguages.map((l) => `${l.name} (${l.level})`).join(" · ")}</dd></div>
          {skillCategories.map((c) => <div><dt>{c.label}</dt><dd>{c.items.join(" · ")}</dd></div>)}
        </dl>
      </section>
      <div>
        <section aria-labelledby="cv-edu-h">
          <h2 id="cv-edu-h" class="cv-h3">{w.education}</h2>
          <dl class="stone-rows cv-table">
            {education.map((e) => <div><dt>{e.startYear} – {e.endYear}</dt><dd>{e.degree} — {e.institution}{note(e) && <span class="cv-note">{note(e)}</span>}</dd></div>)}
          </dl>
        </section>
        <section aria-labelledby="cv-cert-h">
          <h2 id="cv-cert-h" class="cv-h3">{w.certifications}</h2>
          <dl class="stone-rows cv-table">
            {certifications.map((c) => <div><dt>{c.year}</dt><dd>{c.name} — {c.institution}{c.credential && <span class="cv-note">{c.credential}</span>}</dd></div>)}
          </dl>
        </section>
      </div>
    </div>
  </div>
</OverzichtLayout>
