---
// /projects: the set's drawing register. ANNA leads with its section drawing, the drawn
// projects follow with their details, and the register continues the same list with the rest.
import OverzichtLayout from "../../layouts/OverzichtLayout.astro";
import DetailCard from "../../components/overzicht/DetailCard.astro";
import AnnaPlate from "../../components/overzicht/AnnaPlate.astro";
import RegisterSheet from "../../components/overzicht/RegisterSheet.astro";
import { annaLead, details } from "../../config/home";
import site from "../../config/site";

const entries = Object.values(import.meta.glob("./*.mdx", { eager: true })) as any[];
const projects = entries.map((m) => ({ title: m.frontmatter?.title ?? "Untitled", tags: m.frontmatter?.tech ?? [] }));

const projectsDescription = `Explore ${site.name}'s portfolio of projects including ${projects.map((p) => p.title).join(", ")}. Case studies and technical write-ups for selected work.`;
const projectsKeywords = `${site.seo.keywords}, projects, portfolio, case studies, ${projects.flatMap((p) => p.tags).join(", ")}`;
---

<OverzichtLayout
  current="projects"
  title={`Projects — ${site.name}`}
  description={projectsDescription}
  keywords={projectsKeywords}
  ogTitle={`Projects & Portfolio — ${site.name}`}
  ogDescription={projectsDescription}
>
  <section class="sheet sheet-first" aria-labelledby="projects-h">
    <header class="sheet-head">
      <h1 id="projects-h">Projects</h1>
      <p>Detailed write-ups for selected work.</p>
    </header>

    <div class="details details-rows">
      <article class="detail detail-lead" id={annaLead.id}>
        <AnnaPlate />
        <div class="detail-text">
          <h2><a href={annaLead.caseStudy}>{annaLead.title}</a></h2>
          <p>{annaLead.text}</p>
          <p class="detail-status">{annaLead.status}</p>
          <p class="links"><a href={annaLead.caseStudy}>Case study</a></p>
        </div>
      </article>
      {details.map(d => <DetailCard detail={d} heading="h2" />)}
    </div>
    <RegisterSheet inline />
  </section>
</OverzichtLayout>
