---
// /contact: the form, drawn as a transmittal sheet with the homepage's stamp. The Worker
// (/api/contact) checks Turnstile, the honeypot and the elapsed time server-side.
import OverzichtLayout from "../layouts/OverzichtLayout.astro";
import site from "../config/site";

const contactDescription = `Get in touch with ${site.name}. Send me a message about work opportunities, projects, or just to chat about Formula 1 and tech.`;
const contactKeywords = `${site.seo.keywords}, contact, hire, collaborate, message, email`;

// Turnstile: always-passing test key on the dev server, real key in production builds.
// Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
const turnstileSiteKey = import.meta.env.DEV ? '1x00000000000000000000AA' : site.turnstileSiteKey;
---

<OverzichtLayout
  current="contact"
  title={`Contact — ${site.name}`}
  description={contactDescription}
  keywords={contactKeywords}
  ogTitle={`Contact ${site.name} — ${site.role}`}
  ogDescription={contactDescription}
>
  <section class="sheet sheet-first sheet-transmittal" aria-labelledby="contact-h">
    <header class="sheet-head">
      <h1 id="contact-h">Get in touch</h1>
      <p>{site.contactMessage}</p>
    </header>

    <div class="tm-wrap">
    <form id="contactForm" class="transmittal" method="POST" data-turnstile-sitekey={turnstileSiteKey}>
      <div class="tm-row"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
      <div class="tm-row"><label for="email">Email</label><input id="email" type="email" name="email" autocomplete="email" required /></div>
      <div class="tm-row tm-msg"><label for="message">Message</label><textarea id="message" name="message" rows="7" required></textarea></div>

      <!-- Honeypot: humans never see or fill this; bots that fill every field do. Checked server-side. -->
      <div class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <!-- Milliseconds between page load and submit, set by the script below. -->
      <input type="hidden" name="elapsed" id="elapsed" value="" />

      <div class="tm-foot">
        <!-- Cloudflare Turnstile widget, rendered explicitly by the script below -->
        <div id="turnstile-container"></div>
        <button type="submit" id="submitButton" class="act act-main">
          <span class="submit-text">Send Message</span>
          <span class="submit-loading" hidden>Sending...</span>
        </button>
      </div>
      <p id="statusMessage" role="status" hidden></p>
    </form>
      <div class="stamp" aria-hidden="true"><span>Issued for</span><b>conversation</b><span>2026</span></div>
    </div>
  </section>

  <script is:inline>
    // Called by the Turnstile script once loaded (see ?onload= on the script tag below).
    // Explicit rendering so the widget id is known and can be reset after each submit;
    // Turnstile tokens are single-use.
    window.onTurnstileLoad = function () {
      var form = document.getElementById('contactForm');
      var sitekey = form ? form.getAttribute('data-turnstile-sitekey') : null;
      if (!sitekey || !window.turnstile) return;
      window.__turnstileWidgetId = window.turnstile.render('#turnstile-container', {
        sitekey: sitekey,
        action: 'contact',
        // follow the sheet's chosen theme, not just the system's
        theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : document.documentElement.dataset.theme === 'light' ? 'light' : 'auto',
        size: 'flexible',
      });
    };
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>

  <script>
    // Contact form submission handler
    document.addEventListener('DOMContentLoaded', function() {
      const loadedAt = Date.now();
      const form = document.getElementById('contactForm') as HTMLFormElement;
      const elapsedField = document.getElementById('elapsed') as HTMLInputElement;
      const statusMessage = document.getElementById('statusMessage') as HTMLElement;
      const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
      const submitText = submitButton.querySelector('.submit-text') as HTMLElement;
      const submitLoading = submitButton.querySelector('.submit-loading') as HTMLElement;

      function showStatus(message: string, isError: boolean = false) {
        statusMessage.dataset.kind = isError ? 'error' : 'sent';
        statusMessage.textContent = message;
        statusMessage.hidden = false;

        // Auto-hide success messages after 5 seconds
        if (!isError) {
          setTimeout(() => {
            statusMessage.hidden = true;
          }, 5000);
        }
      }

      function setLoading(loading: boolean) {
        submitButton.disabled = loading;
        submitText.hidden = loading;
        submitLoading.hidden = !loading;
      }

      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Hide any previous status messages
        statusMessage.hidden = true;
        setLoading(true);

        try {
          const turnstile = (window as any).turnstile;
          const widgetId = (window as any).__turnstileWidgetId;
          const token: string = turnstile && widgetId !== undefined ? turnstile.getResponse(widgetId) || '' : '';
          if (!token) {
            showStatus('Verification is still loading. Please wait a moment and try again.', true);
            setLoading(false);
            return;
          }

          elapsedField.value = String(Date.now() - loadedAt);
          const formData = new FormData(form);
          formData.set('cf-turnstile-response', token);

          const response = await fetch('/api/contact', {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (response.ok && result.success) {
            showStatus('Thank you! Your message has been sent successfully. I\'ll get back to you soon.');
            form.reset();
          } else {
            showStatus(result.error || 'Something went wrong. Please try again.', true);
          }
        } catch (error) {
          showStatus('Network error. Please check your connection and try again.', true);
        } finally {
          // Tokens are single-use: get a fresh one for any retry.
          const turnstile = (window as any).turnstile;
          const widgetId = (window as any).__turnstileWidgetId;
          if (turnstile && widgetId !== undefined) turnstile.reset(widgetId);
          setLoading(false);
        }
      });
    });
  </script>
</OverzichtLayout>
