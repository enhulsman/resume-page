---
// /contact (openspec stone-inner-pages, stone-contact; Ezra, 2026-11-10, C2 wide): the heading, the
// message and the address set large on the left; the form inside a frosted "New message" window over
// the flame's glow on the right. The form's fields, names, script and Turnstile are unchanged; its
// words come from pageWords. The Worker (/api/contact) checks Turnstile, the honeypot and the elapsed
// time server-side.
import OverzichtLayout from "../layouts/OverzichtLayout.astro";
import GlassWindow from "../components/stone/GlassWindow.astro";
import site from "../config/site";
import { homeSections, siteNav } from "../config/home.ts";
import { pageWords } from "../config/pages.ts";

const w = pageWords.contact;
const contactDescription = `Get in touch with ${site.name}. Send me a message about work opportunities, projects, or just to chat about Formula 1 and tech.`;
const contactKeywords = `${site.seo.keywords}, contact, hire, collaborate, message, email`;

// Turnstile: always-passing test key on the dev server, real key in production builds.
// Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
const turnstileSiteKey = import.meta.env.DEV ? '1x00000000000000000000AA' : site.turnstileSiteKey;
---

<OverzichtLayout
  current="contact"
  title={`Contact — ${site.name}`}
  description={contactDescription}
  keywords={contactKeywords}
  ogTitle={`Contact ${site.name} — ${site.role}`}
  ogDescription={contactDescription}
>
  <section class="ct" aria-labelledby="ct-h">
    <header class="ct-head">
      <h1 id="ct-h" class="ct-title">{siteNav.cta.label}</h1>
      <p class="ct-lead">{site.contactMessage}</p>
    </header>

    <div class="ct-formcol" data-glass-moment="compose">
      <GlassWindow title={w.window} glow="flame" class="ct-stage" windowClass="ct-window">
        <div class="ct-body">
          <form id="contactForm" class="ct-form" method="POST" data-turnstile-sitekey={turnstileSiteKey}>
            <div class="ct-row"><label for="name">{w.name}</label><input id="name" name="name" autocomplete="name" required /></div>
            <div class="ct-row"><label for="email">{w.email}</label><input id="email" type="email" name="email" autocomplete="email" required /></div>
            <div class="ct-row"><label for="message">{w.message}</label><textarea id="message" name="message" rows="7" required></textarea></div>

            <!-- Honeypot: humans never see or fill this; bots that fill every field do. Checked server-side. -->
            <div class="hp-field" aria-hidden="true">
              <label for="website">{w.website}</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <!-- Milliseconds between page load and submit, set by the script below. -->
            <input type="hidden" name="elapsed" id="elapsed" value="" />

            <div class="ct-foot">
              <!-- Cloudflare Turnstile widget, rendered explicitly by the script below -->
              <div id="turnstile-container"></div>
              <button type="submit" id="submitButton" class="ct-send">
                <span class="submit-text">{w.send}</span>
                <span class="submit-loading" hidden>{w.sending}</span>
              </button>
            </div>
            <p id="statusMessage" role="status" hidden></p>
          </form>
        </div>
      </GlassWindow>
    </div>

    <div class="ct-ways">
      <a class="ct-mail" href={`mailto:${site.social.email}`}>{site.social.email}</a>
      <ul class="ct-links">
        <li><a href={site.social.LinkedIn}>{homeSections.contact.linkedin}</a></li>
        <li><a href={site.social.GitHub}>{homeSections.contact.github}</a></li>
      </ul>
    </div>
  </section>

  <script is:inline>
    // Called by the Turnstile script once loaded (see ?onload= on the script tag below).
    // Explicit rendering so the widget id is known and can be reset after each submit;
    // Turnstile tokens are single-use.
    window.onTurnstileLoad = function () {
      var form = document.getElementById('contactForm');
      var sitekey = form ? form.getAttribute('data-turnstile-sitekey') : null;
      if (!sitekey || !window.turnstile) return;
      window.__turnstileWidgetId = window.turnstile.render('#turnstile-container', {
        sitekey: sitekey,
        action: 'contact',
        // the site is light stone in every system theme
        theme: 'light',
        size: 'flexible',
      });
    };
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad" async defer></script>

  <script>
    // Contact form submission handler; its messages from pageWords
    import { pageWords } from "../config/pages.ts";
    const words = pageWords.contact;
    document.addEventListener('DOMContentLoaded', function() {
      const loadedAt = Date.now();
      const form = document.getElementById('contactForm') as HTMLFormElement;
      const elapsedField = document.getElementById('elapsed') as HTMLInputElement;
      const statusMessage = document.getElementById('statusMessage') as HTMLElement;
      const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
      const submitText = submitButton.querySelector('.submit-text') as HTMLElement;
      const submitLoading = submitButton.querySelector('.submit-loading') as HTMLElement;

      function showStatus(message: string, isError: boolean = false) {
        statusMessage.dataset.kind = isError ? 'error' : 'sent';
        statusMessage.textContent = message;
        statusMessage.hidden = false;

        // Auto-hide success messages after 5 seconds
        if (!isError) {
          setTimeout(() => {
            statusMessage.hidden = true;
          }, 5000);
        }
      }

      function setLoading(loading: boolean) {
        submitButton.disabled = loading;
        submitText.hidden = loading;
        submitLoading.hidden = !loading;
      }

      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Hide any previous status messages
        statusMessage.hidden = true;
        setLoading(true);

        try {
          const turnstile = (window as any).turnstile;
          const widgetId = (window as any).__turnstileWidgetId;
          const token: string = turnstile && widgetId !== undefined ? turnstile.getResponse(widgetId) || '' : '';
          if (!token) {
            showStatus(words.waiting, true);
            setLoading(false);
            return;
          }

          elapsedField.value = String(Date.now() - loadedAt);
          const formData = new FormData(form);
          formData.set('cf-turnstile-response', token);

          const response = await fetch('/api/contact', {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (response.ok && result.success) {
            showStatus(words.sent);
            form.reset();
          } else {
            showStatus(result.error || words.failed, true);
          }
        } catch (error) {
          showStatus(words.offline, true);
        } finally {
          // Tokens are single-use: get a fresh one for any retry.
          const turnstile = (window as any).turnstile;
          const widgetId = (window as any).__turnstileWidgetId;
          if (turnstile && widgetId !== undefined) turnstile.reset(widgetId);
          setLoading(false);
        }
      });
    });
  </script>
</OverzichtLayout>
