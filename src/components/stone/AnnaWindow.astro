---
// ANNA's Teams window (anna-section; factored out of AnnaSection.astro for stone-inner-pages, Ezra,
// 2026-11-10: the same window opens her project page): anna-site's "Close my week" plays once when the
// window is about 40% in view (40% of the screen when it is taller), with Replay. Every word from
// config: annaCalls, annaLead (home.ts) and annaDemo (anna-demo.ts). One per page.
//
// The caller's element that holds it carries the class `anna-window` (the homepage's section, the
// article's wrapper on her page): src/scripts/glass/anna-window.js binds that element and keys on the
// class names here (.aw-window, .aw-compose, .aw-replay, [data-beat], .aw-work), and sets .aw-live on
// it. The inline script marks that element pending as the beats are parsed (no flash of the finished
// chat); if the driver has not taken over by load, every beat shows, as it does without JavaScript.
// The window is as tall as the finished conversation from the first frame, so nothing in it scrolls.
// The text-on-glass colours in stone.css key on .msg .who and .aw-work. The transcript is a named
// region.
import "../../styles/stone.css";
import GlassWindow from "./GlassWindow.astro";
import { annaLead, annaCalls } from "../../config/home.ts";
import { annaDemo } from "../../config/anna-demo.ts";

interface Props {
  /** Classes on the stage (its width is the caller's). */
  class?: string;
}
const { class: cls } = Astro.props;
---
<script is:inline>
  // hide the beats before they are parsed; if the driver has not taken over by load, show them
  (function (s) {
    s.classList.add('aw-pending');
    addEventListener('load', function () { if (!s.classList.contains('aw-live')) s.classList.remove('aw-pending'); });
  })(document.currentScript.parentElement);
</script>
<GlassWindow title={annaCalls.window} glow="flame" class={cls} windowClass="aw-window">
  <button slot="bar" type="button" class="aw-replay">{annaCalls.replay}</button>
  <div class="aw-chat" role="region" aria-label={annaCalls.chat}>
    <div class="aw-log">
      <div class="msg joris" data-beat="person"><span class="who">{annaDemo.who}</span><p class="text">{annaDemo.person}</p></div>
      <div class="msg anna" data-beat="answer"><span class="who">{annaLead.title}</span><p class="text">{annaDemo.answer}</p></div>
      <p class="aw-work" data-beat="sources" data-lines={JSON.stringify(annaCalls.work.lines)} data-done={annaCalls.work.done}><i class="aw-dot" aria-hidden="true"></i><span class="aw-work-t">{annaCalls.work.done}</span></p>
      <div class="msg anna" data-beat="question"><p class="text">{annaDemo.question}</p></div>
      <div class="msg joris" data-beat="reply"><span class="who">{annaDemo.who}</span><p class="text">{annaDemo.reply}</p></div>
      <div class="msg anna" data-beat="result"><span class="who">{annaLead.title}</span><p class="text">{annaDemo.result}</p></div>
    </div>
  </div>
  <div class="aw-compose" aria-hidden="true"><span class="aw-field"><span class="aw-typed"></span><i class="aw-caret"></i></span></div>
</GlassWindow>

<style is:global>
  /* no fixed height: as tall as the finished conversation from the first frame, nothing scrolls */
  .anna-window .aw-window { height: auto; }
  .anna-window .aw-window .glass-bar { display: grid; grid-template-columns: 1fr auto 1fr; }
  .anna-window .aw-window .glass-bar > .glass-title { grid-column: 2; }
  .anna-window .aw-replay {
    grid-column: 3; justify-self: end; border: 0; background: none; padding: 4px 2px; cursor: pointer;
    font: 500 12.5px/1 var(--stone-sans); border-radius: 6px;
  }
  .anna-window .aw-replay:focus-visible { outline: 2px solid var(--stone-ink); outline-offset: 2px; }
  /* Replay needs the driver */
  .anna-window:not(.aw-live) .aw-replay { display: none; }
  .anna-window .aw-chat { position: relative; z-index: 3; }
  .anna-window .aw-log { display: flex; flex-direction: column; padding: 22px 22px 6px; font-size: 15px; line-height: 1.45; }
  .anna-window .aw-log p { margin: 0; }
  /* each beat is in the page from the start; with a script running, it shows when it lands */
  .anna-window [data-beat] { transition: opacity 0.45s ease, transform 0.5s cubic-bezier(.2,.7,.2,1); }
  .anna-window:is(.aw-pending, .aw-live) [data-beat]:not(.on) { opacity: 0; transform: translateY(6px); }
  .anna-window .msg { max-width: 86%; text-wrap: pretty; }
  .anna-window .msg .who { display: block; margin: 0 0 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.01em; }
  .anna-window .msg .text { padding: 10px 14px; border-radius: 14px; }
  /* Joris: to the right, a faint ink tint; ANNA: on the left, lifted a little lighter than the glass */
  .anna-window .msg.joris { align-self: flex-end; text-align: left; }
  .anna-window .msg.joris .who { text-align: right; }
  .anna-window .msg.joris .text { background: rgb(17 17 16 / 0.055); }
  .anna-window .msg.anna { align-self: flex-start; }
  .anna-window .msg.anna .text { background: rgb(255 255 255 / 0.34); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35); }
  .anna-window .msg + .msg { margin-top: 6px; }
  .anna-window .msg.joris + .msg.anna, .anna-window .msg.anna + .msg.joris, .anna-window .aw-work + .msg { margin-top: 18px; }

  /* her work: one line under her answer, a dot that pulses while she works; one line, fixed height */
  .anna-window .aw-work {
    display: flex; align-items: baseline; gap: 9px; margin: 13px 0 0 24px; max-width: calc(100% - 24px);
    height: 1.45em; font-size: 13px; line-height: 1.45; white-space: nowrap; overflow: hidden;
  }
  .anna-window .aw-dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--glass-ink-red); transform: translateY(-1px); }
  .anna-window .aw-work.working .aw-dot { animation: aw-pulse 1.1s ease-in-out infinite; }
  .anna-window .aw-work.settled .aw-dot { background: rgb(17 17 16 / 0.25); }
  .anna-window .aw-work-t { min-width: 0; overflow: hidden; text-overflow: ellipsis; transition: opacity 0.4s ease; }
  .anna-window .aw-work-t.out { opacity: 0; transition-duration: 0.25s; }
  @keyframes aw-pulse { 50% { opacity: 0.35; } }

  /* the box Joris types into: his reply goes in here first, then is sent */
  .anna-window .aw-compose { position: relative; z-index: 3; flex: none; padding: 10px 14px 14px; opacity: 0.4; transition: opacity 0.4s ease; }
  .anna-window .aw-compose.typing { opacity: 1; }
  .anna-window .aw-field {
    display: flex; align-items: center; height: 40px; padding: 0 14px; border-radius: 12px;
    background: rgb(255 255 255 / 0.3); box-shadow: inset 0 0 0 1px rgb(17 17 16 / 0.07);
    font-size: 15px; white-space: nowrap; overflow: hidden;
  }
  .anna-window .aw-caret { display: none; width: 1.5px; height: 1.15em; margin-left: 1px; background: var(--stone-ink); }
  .anna-window .aw-compose.typing .aw-caret { display: inline-block; }

  @media (prefers-reduced-motion: reduce) {
    .anna-window [data-beat], .anna-window:is(.aw-pending, .aw-live) [data-beat]:not(.on) { transition: none; transform: none; }
    .anna-window .aw-compose, .anna-window .aw-work-t { transition: none; }
    .anna-window .aw-work.working .aw-dot { animation: none; }
    .anna-window .aw-replay { display: none; }
  }
  @media (max-width: 760px) {
    .anna-window .aw-log { padding: 18px 14px 4px; font-size: 14.5px; }
    .anna-window .msg { max-width: 92%; }
  }
</style>
