---
// ANNA's section (openspec stone-glass-homepage, anna-section): what she may do, and for whom, as
// type on stone; beside it (below it on a phone) a frosted Teams window where anna-site's "Close my
// week" plays once as it comes into view, with Replay. The second glass moment.
// Every word comes from config: annaLead, annaCalls (home.ts) and annaDemo (anna-demo.ts); the index
// is ANNA's card's. Every beat is in the page from the start. Without JavaScript (or when the
// driver never loads) the whole conversation shows; with it, the inline script below hides the beats
// as they are parsed (no flash of the finished chat) and the driver shows each as it lands. The
// driver is src/scripts/glass/anna-window.js, which keys on the class names here (.anna-window,
// .aw-*, [data-beat]) and sets .aw-live; the text-on-glass colours in stone.css key on .msg .who
// and .aw-work. The transcript is a named region.
//
// Sketch round 2 (Ezra, 2026-11-11): her work is one line under her answer (C2), what she read and
// then each step replacing the last, settling into a summary; no steps list and no record. The
// window is as tall as the finished conversation from the first frame (every beat laid out, hidden
// until it lands), so nothing in it scrolls and its size never changes; the work line is one line
// at a fixed height (an ellipsis is the fallback, the copy in config fits). The window's top stands
// level with the index "01", beside the heading, after today's stone under the hero.
import "../../styles/stone.css";
import GlassWindow from "./GlassWindow.astro";
import { glassCards } from "../../config/glass.ts";
import { annaLead, annaCalls } from "../../config/home.ts";
import { annaDemo } from "../../config/anna-demo.ts";

const idx = String(glassCards.findIndex((c) => c.id === annaLead.id) + 1).padStart(2, "0");
---

<section class="anna-window" data-glass-moment="anna" aria-labelledby="anna-h">
  <script is:inline>
    // hide the beats before they are parsed; if the driver has not taken over by load, show them
    (function (s) {
      s.classList.add('aw-pending');
      addEventListener('load', function () { if (!s.classList.contains('aw-live')) s.classList.remove('aw-pending'); });
    })(document.currentScript.parentElement);
  </script>
  <div class="aw-copy">
    <header class="aw-head">
      <span class="aw-idx">{idx}</span>
      <h2 id="anna-h">{annaLead.title}</h2>
      <p class="aw-lead">{annaLead.text}.</p>
      <h3>{annaCalls.heading}</h3>
    </header>
    <ol class="aw-rules">
      {annaCalls.rules.map((r) => <li><strong class="rule">{r.rule}</strong> <span class="why">{r.why}</span> <span class="how">{r.how}</span></li>)}
    </ol>
    <p class="aw-closing">{annaCalls.closing}</p>
    <a class="more" href={annaCalls.more.href}>{annaCalls.more.label} <span aria-hidden="true">→</span></a>
  </div>
  <GlassWindow title={annaCalls.window} glow="flame" class="aw-stage" windowClass="aw-window">
    <button slot="bar" type="button" class="aw-replay">{annaCalls.replay}</button>
    <div class="aw-chat" role="region" aria-label={annaCalls.chat}>
      <div class="aw-log">
        <div class="msg joris" data-beat="person"><span class="who">{annaDemo.who}</span><p class="text">{annaDemo.person}</p></div>
        <div class="msg anna" data-beat="answer"><span class="who">{annaLead.title}</span><p class="text">{annaDemo.answer}</p></div>
        <p class="aw-work" data-beat="sources" data-lines={JSON.stringify(annaCalls.work.lines)} data-done={annaCalls.work.done}><i class="aw-dot" aria-hidden="true"></i><span class="aw-work-t">{annaCalls.work.done}</span></p>
        <div class="msg anna" data-beat="question"><p class="text">{annaDemo.question}</p></div>
        <div class="msg joris" data-beat="reply"><span class="who">{annaDemo.who}</span><p class="text">{annaDemo.reply}</p></div>
        <div class="msg anna" data-beat="result"><span class="who">{annaLead.title}</span><p class="text">{annaDemo.result}</p></div>
      </div>
    </div>
    <div class="aw-compose" aria-hidden="true"><span class="aw-field"><span class="aw-typed"></span><i class="aw-caret"></i></span></div>
  </GlassWindow>
</section>

<style>
  /* desktop: the copy on the left; the window on the right, its top level with the index "01" */
  .anna-window {
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: start;
    column-gap: clamp(24px, 5vw, 96px);
    padding: clamp(120px, 22svh, 220px) var(--stone-gutter) clamp(72px, 12svh, 140px);
    font-family: var(--stone-sans); color: var(--stone-ink);
    -webkit-font-smoothing: antialiased;
    /* the glow reaches past the window's sides; it never widens the page */
    overflow-x: clip;
  }
  .aw-copy { grid-column: 1; grid-row: 1; max-width: 480px; }

  .aw-idx {
    display: block; margin-bottom: 0.6em;
    font-size: var(--stone-t-small); font-weight: 600; letter-spacing: 0.06em; font-variant-numeric: tabular-nums;
    color: var(--stone-ink-2);
  }
  h2 { margin: 0; font: 900 var(--stone-t-h2)/0.9 var(--stone-sans); font-stretch: 88%; letter-spacing: -0.04em; }
  .aw-lead { margin: 0.8em 0 0; font-size: var(--stone-t-lead); line-height: 1.34; color: var(--stone-ink-2); text-wrap: pretty; }
  h3 { margin: 1.7em 0 0; font-weight: 700; font-size: var(--stone-t-h3); letter-spacing: -0.02em; line-height: 1.15; }
  .aw-rules { list-style: none; margin: 0; padding: 0; }
  .aw-rules li { padding-top: 1.05em; font-size: var(--stone-t-body); line-height: 1.4; color: var(--stone-ink-2); text-wrap: pretty; }
  .aw-rules li:first-child { padding-top: 0.9em; }
  .aw-rules .rule { display: block; font-weight: 680; font-size: clamp(17px, 1.3vw, 19.5px); letter-spacing: -0.012em; color: var(--stone-ink); margin-bottom: 0.15em; }
  .aw-rules .how { display: block; margin-top: 0.2em; font-size: 0.88em; font-style: italic; color: #645c53; }
  .aw-closing { margin: 1.5em 0 0; font-size: var(--stone-t-body); line-height: 1.4; color: var(--stone-ink-2); }
  .more { display: inline-block; margin-top: 1em; font-weight: 600; color: var(--stone-ink); }

  /* the window's column: the stage is the window's own width, so the glow sits around the window */
  .anna-window :global(.aw-stage) {
    grid-column: 2; grid-row: 1; align-self: start; justify-self: center;
    width: min(100%, 620px);
  }
  /* no fixed height: as tall as the finished conversation from the first frame, nothing scrolls */
  .anna-window :global(.aw-window) { height: auto; }
  .anna-window :global(.aw-window .glass-bar) { display: grid; grid-template-columns: 1fr auto 1fr; }
  .anna-window :global(.aw-window .glass-bar > .glass-title) { grid-column: 2; }
  .aw-replay {
    grid-column: 3; justify-self: end; border: 0; background: none; padding: 4px 2px; cursor: pointer;
    font: 500 12.5px/1 var(--stone-sans); border-radius: 6px;
  }
  .aw-replay:focus-visible { outline: 2px solid var(--stone-ink); outline-offset: 2px; }
  /* Replay needs the driver */
  .anna-window:not(.aw-live) .aw-replay { display: none; }
  .aw-chat { position: relative; z-index: 3; }
  .aw-log { display: flex; flex-direction: column; padding: 22px 22px 6px; font-size: 15px; line-height: 1.45; }
  .aw-log p { margin: 0; }
  /* each beat is in the page from the start; with a script running, it shows when it lands */
  [data-beat] { transition: opacity 0.45s ease, transform 0.5s cubic-bezier(.2,.7,.2,1); }
  .anna-window:is(.aw-pending, .aw-live) [data-beat]:not(.on) { opacity: 0; transform: translateY(6px); }
  .msg { max-width: 86%; text-wrap: pretty; }
  .msg .who { display: block; margin: 0 0 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.01em; }
  .msg .text { padding: 10px 14px; border-radius: 14px; }
  /* Joris: to the right, a faint ink tint; ANNA: on the left, lifted a little lighter than the glass */
  .msg.joris { align-self: flex-end; text-align: left; }
  .msg.joris .who { text-align: right; }
  .msg.joris .text { background: rgb(17 17 16 / 0.055); }
  .msg.anna { align-self: flex-start; }
  .msg.anna .text { background: rgb(255 255 255 / 0.34); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35); }
  .msg + .msg { margin-top: 6px; }
  .msg.joris + .msg.anna, .msg.anna + .msg.joris, .aw-work + .msg { margin-top: 18px; }

  /* her work: one line under her answer, a dot that pulses while she works; one line, fixed height */
  .aw-work {
    display: flex; align-items: baseline; gap: 9px; margin: 13px 0 0 24px; max-width: calc(100% - 24px);
    height: 1.45em; font-size: 13px; line-height: 1.45; white-space: nowrap; overflow: hidden;
  }
  .aw-dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--glass-ink-red); transform: translateY(-1px); }
  .aw-work.working .aw-dot { animation: aw-pulse 1.1s ease-in-out infinite; }
  .aw-work.settled .aw-dot { background: rgb(17 17 16 / 0.25); }
  .aw-work-t { min-width: 0; overflow: hidden; text-overflow: ellipsis; transition: opacity 0.4s ease; }
  .aw-work-t.out { opacity: 0; transition-duration: 0.25s; }
  @keyframes aw-pulse { 50% { opacity: 0.35; } }

  /* the box Joris types into: his reply goes in here first, then is sent */
  .aw-compose { position: relative; z-index: 3; flex: none; padding: 10px 14px 14px; opacity: 0.4; transition: opacity 0.4s ease; }
  .aw-compose.typing { opacity: 1; }
  .aw-field {
    display: flex; align-items: center; height: 40px; padding: 0 14px; border-radius: 12px;
    background: rgb(255 255 255 / 0.3); box-shadow: inset 0 0 0 1px rgb(17 17 16 / 0.07);
    font-size: 15px; white-space: nowrap; overflow: hidden;
  }
  .aw-caret { display: none; width: 1.5px; height: 1.15em; margin-left: 1px; background: var(--stone-ink); }
  .aw-compose.typing .aw-caret { display: inline-block; }

  @media (prefers-reduced-motion: reduce) {
    [data-beat], .anna-window:is(.aw-pending, .aw-live) [data-beat]:not(.on) { transition: none; transform: none; }
    .aw-compose, .aw-work-t { transition: none; }
    .aw-work.working .aw-dot { animation: none; }
    .aw-replay { display: none; }
  }

  /* a phone: the copy, then the window under it */
  @media (max-width: 760px) {
    .anna-window { display: block; padding-block: 96px 72px; }
    h2 { font-size: 56px; }
    .anna-window :global(.aw-stage) { width: 100%; margin-top: 40px; }
    .aw-log { padding: 18px 14px 4px; font-size: 14.5px; }
    .msg { max-width: 92%; }
  }
</style>
