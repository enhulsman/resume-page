---
import site from "../../config/site";
import { register } from "../../config/home";
---
<section class="sheet" id="register" aria-labelledby="register-h">
  <header class="sheet-head">
    <h2 id="register-h">Also in the set</h2>
    <p>The rest of the set: smaller builds, each with its own sheet.</p>
  </header>
  <table class="register">
    <thead><tr><th scope="col">Project</th><th scope="col">What it is</th><th scope="col">Status</th></tr></thead>
    <tbody>
      {register.map(r => <tr><td><a href={r.href}>{r.title}</a></td><td>{r.what}</td><td>{r.status}</td></tr>)}
    </tbody>
  </table>

  <h3 class="sub" id="side">Other sheets, drawn for fun</h3>
  <ul class="side">
    {site.sidePieces.map(p => <li><a href={p.url}>{p.url.replace("https://", "")}</a><span>{p.line}</span></li>)}
  </ul>
</section>
