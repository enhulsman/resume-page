          <text x="85" y="142" text-anchor="middle">native</text>
          <text x="85" y="156" class="sm" text-anchor="middle">crossterm</text>
          <text x="85" y="168" class="sm" text-anchor="middle">1,191 lines</text>
          <text x="435" y="142" text-anchor="middle">web</text>
          <text x="435" y="156" class="sm" text-anchor="middle">ratzilla</text>
          <text x="435" y="168" class="sm" text-anchor="middle">102 lines</text>
          <text x="48" y="240" class="sm">$ bible</text>
          <text x="85" y="282" class="sm" text-anchor="middle">a terminal</text>
          <text x="435" y="282" class="sm" text-anchor="middle">bible.hulsman.dev</text>
