          <path d="M80 150 H108" class="arrow"/>
          <path d="M112 110 H200 V190 H112 Z" class="cut"/>
          <path d="M156 110 V64 H408" class="arrow"/>
          <path d="M200 165 H236" class="arrow"/>
          <path d="M240 130 H322 V200 H240 Z" class="cut"/>
          <path d="M322 165 H352"/>
