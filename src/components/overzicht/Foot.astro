---
// The stone footer on every page: its words in config (footer in home.ts), the name from site.ts;
// the full stop after the name is markup.
import site from "../../config/site";
import { footer } from "../../config/home.ts";
---
<footer class="foot">
  <p>{footer.line} {site.name}. <a href={site.quoteUrl}>{footer.verse}</a></p>
</footer>
