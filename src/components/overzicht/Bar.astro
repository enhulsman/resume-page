---
// The sheet's top bar: the same page links on every sheet, homepage included, with the one you
// are on marked. The theme button and the phone menu are driven by src/scripts/overzicht/chrome.js;
// at 860px and below the links fold into the menu. The menu button comes before the links so they
// follow it in keyboard order; CSS draws it last.
interface Props {
  /** The inner page this bar sits on; leave it out on the homepage. */
  current?: "projects" | "blog" | "resume" | "contact";
}
const { current } = Astro.props;
const links = [["projects", "/projects", "Projects"], ["blog", "/blog", "Blog"], ["resume", "/resume", "Résumé"], ["contact", "/contact", "Contact"]];
---
<header class="bar">
  <a class="bar-name" href={current ? "/" : "#top"}>E. Hulsman</a>
  <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="bar-nav">
    <svg class="menu-lines" viewBox="0 0 18 14" aria-hidden="true">
      <path pathLength="1" class="ml" d="M1 2 H17"/><path pathLength="1" class="ml" d="M1 7 H17"/><path pathLength="1" class="ml" d="M1 12 H17"/>
      <path pathLength="1" class="mx" d="M3 1 L15 13"/><path pathLength="1" class="mx" d="M15 1 L3 13"/>
    </svg>
  </button>
  <nav id="bar-nav" aria-label="Site">
    {links.map(([id, href, label], i) => <a href={href} style={`--i:${i}`} aria-current={id === current ? "page" : undefined}>{label}</a>)}
  </nav>
  <button class="theme" type="button" aria-pressed="false" title="Switch to the dark sheet"><svg class="lamp" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 15h7M5 15v-5l4-4"/><path class="shade" d="M8 4.5 12 3l2.5 6.5-3.5.5z"/></svg><span class="theme-label">Light table</span></button>
</header>
