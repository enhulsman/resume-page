---
// The stone bar on every page (openspec stone-glass-homepage, shared chrome): the signature (the
// favicon's "EH.") with the full name beside it, linking home; the four page links with the one
// you are on marked; and "Get in touch". At 860px and below the four links fold into the menu
// (src/scripts/overzicht/chrome.js); the mark and "Get in touch" stay. The menu button comes before
// the links so they follow it in keyboard order; CSS draws it last. Every word is in config.
import site from "../../config/site";
import { siteNav } from "../../config/home.ts";

interface Props {
  /** The inner page this bar sits on; leave it out on the homepage. */
  current?: "projects" | "blog" | "resume" | "contact";
}
const { current } = Astro.props;
---
<header class="bar">
  <a class="bar-name" href="/"><span class="sig" aria-hidden="true">EH<span class="sig-dot">.</span></span>{site.name}</a>
  <button class="menu-btn" type="button" aria-label={siteNav.menu} aria-expanded="false" aria-controls="bar-nav">
    <svg class="menu-lines" viewBox="0 0 18 14" aria-hidden="true">
      <path class="ml" d="M1 2 H17"/><path class="ml" d="M1 7 H17"/><path class="ml" d="M1 12 H17"/>
      <path class="mx" d="M3 1 L15 13"/><path class="mx" d="M15 1 L3 13"/>
    </svg>
  </button>
  <nav id="bar-nav" aria-label="Site">
    {siteNav.links.map((l, i) => <a href={l.href} style={`--i:${i}`} aria-current={l.id === current ? "page" : undefined}>{l.label}</a>)}
  </nav>
  <a class="bar-cta" href={siteNav.cta.href}>{siteNav.cta.label}</a>
</header>
