---
import { details } from "../../config/home";
import HenkDrawing from "./drawings/HenkDrawing.astro";
import SandboxDrawing from "./drawings/SandboxDrawing.astro";
import HomelabDrawing from "./drawings/HomelabDrawing.astro";
import PytaigaDrawing from "./drawings/PytaigaDrawing.astro";

const drawings = { henk: HenkDrawing, sandbox: SandboxDrawing, homelab: HomelabDrawing, pytaiga: PytaigaDrawing };
---
<section class="sheet" id="details" aria-labelledby="details-h">
  <header class="sheet-head">
    <h2 id="details-h">Details</h2>
    <p>Four more things I built, each drawn at the point where it gets interesting. Not to scale.</p>
  </header>

  <div class="details">
    {details.map(d => {
      const Drawing = drawings[d.id];
      return (
        <article class="detail" id={d.id}>
          <div class="dwg-wrap"><Drawing /></div>
          <div class="detail-text">
            <h3>{d.title}</h3>
            <p>{d.text}</p>
            <dl class="dims">
              {d.dims.map(m => <div><dt>{m.value}</dt><dd>{m.label}</dd></div>)}
            </dl>
            <p class="links"><a href={d.caseStudy}>Case study</a>{d.code && <a href={d.code}>Code</a>}</p>
          </div>
        </article>
      );
    })}
  </div>
</section>
