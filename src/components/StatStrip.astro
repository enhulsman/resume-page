---
// A case study's numbers, drawn as the homepage's dimension strings: each value sits on a
// dimension line with its two ticks. Styles: .dims in src/styles/overzicht.css.
interface Stat {
  value: string;
  label: string;
}

const { stats = [] } = Astro.props as { stats: Stat[] };
---

<dl class="dims dims-strip">
  {stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
</dl>
